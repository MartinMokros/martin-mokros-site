---
// Dev-only design-token page (injected by astro.config.mjs under `astro dev`).
// All sample text is real site copy from Home and Projects.
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/components.css';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured);
const strands = projects.filter((p) => !p.data.featured);

const scale = [
  ['--fs-display', '44 → 88', 'Martin Mokroš', 't-display'],
  ['--fs-h1', '36 → 60', 'What I’m building.', 't-h1'],
  ['--fs-h2', '28 → 42', 'In the field this season.', 't-h2'],
  ['--fs-h3', '22 → 28', 'We’re hiring: an 18-month postdoc on 3DTreePrint', 't-h3'],
  ['--fs-h4', '20', 'UK National Forest Inventory — Thetford', 't-h4'],
  ['--fs-lead', '18 → 20', 'One method — low-cost 3D scanning — carried from UK inventory plots to city streets and tropical community forests.', 't-lead'],
  ['--fs-base', '17', 'Scanning inventory and managed woodland to test whether low-cost handheld LiDAR can match the national standard.', 't-body'],
  ['--fs-sm', '14', 'Funded by ARIA (3DTreePrint) and NCEO (Scanning Together).', 't-sm'],
  ['--fs-label', '12', 'Right now · Summer 2026', 't-label'],
];

const swatches = [
  ['--shadow', 'text, inverse bg'], ['--forest', 'data numerals'], ['--moss', 'subtitle on dark'],
  ['--ochre', 'fills: buttons, rules'], ['--ochre-soft', 'accent on dark, hover'], ['--ochre-ink', 'accent text on paper'],
  ['--paper', 'page'], ['--paper-2', 'alt section'], ['--paper-0', 'card surface (new tint)'],
  ['--ink-soft', 'muted text'], ['--line-strong', 'control outlines'], ['--tag-bg', 'tag fill'],
];

// [fg, bg, role, kind] — kind: text (4.5), ui (3), decor (fill only: never text or focus)
const pairs = [
  ['--text', '--bg', 'Body text on paper', 'text'],
  ['--text', '--bg-alt', 'Body text on paper-2', 'text'],
  ['--text', '--surface', 'Body text on card', 'text'],
  ['--text-muted', '--bg', 'Muted text on paper', 'text'],
  ['--text-muted', '--bg-alt', 'Muted text on paper-2', 'text'],
  ['--text-muted', '--surface', 'Muted text on card', 'text'],
  ['--text-accent', '--bg', 'Labels, links on paper', 'text'],
  ['--text-accent', '--bg-alt', 'Labels, links on paper-2', 'text'],
  ['--text-accent', '--surface', 'Labels, links on card', 'text'],
  ['--text-accent', '--tag-bg', 'Tag', 'text'],
  ['--data', '--bg-alt', 'Stat numerals', 'text'],
  ['--on-accent', '--accent', 'Primary button', 'text'],
  ['--on-accent', '--accent-hover', 'Primary button, hover', 'text'],
  ['--inv-text', '--inv-bg', 'Text on dark', 'text'],
  ['--inv-muted', '--inv-bg', 'Muted text on dark', 'text'],
  ['--inv-accent', '--inv-bg', 'Accent on dark', 'text'],
  ['--moss', '--inv-bg', 'Project subtitle on dark', 'text'],
  ['--line-strong', '--bg', 'Secondary-button outline', 'ui'],
  ['--line-strong', '--bg-alt', 'Secondary-button outline', 'ui'],
  ['--focus', '--bg', 'Focus ring', 'ui'],
  ['--focus', '--bg-alt', 'Focus ring', 'ui'],
  ['--accent', '--bg', 'Ochre fill vs paper', 'decor'],
  ['--accent', '--bg-alt', 'Ochre fill vs paper-2', 'decor'],
];

const space = ['--s-1', '--s-2', '--s-3', '--s-4', '--s-5', '--s-6', '--s-7', '--s-8', '--s-9'];
const icons = [
  ['arrow-right', 'Internal link affordance (buttons, link cards).'],
  ['arrow-up-right', 'Opens another site: project sites, journals, UCL jobs.'],
  ['mail', 'Email links (“Email me”).'],
  ['box', 'Interactive 3D viewer.'],
  ['map-pin', 'Optional: place in field-card meta.'],
  ['calendar', 'Optional: deadline in the open-call facts.'],
  ['download', 'CV download.'],
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Styleguide — redesign tokens</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Geist:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<header class="sg-top">
  <div class="sg-wrap sg-top__row">
    <div>
      <div class="t-label">Redesign · step 2 · local only</div>
      <h1 class="t-h2 sg-title">Design tokens</h1>
    </div>
    <div class="sg-toggle" role="group" aria-label="Heading face for this page">
      <span class="t-meta">Headings</span>
      <button type="button" data-face="serif" aria-pressed="true">Fraunces</button>
      <button type="button" data-face="sans" aria-pressed="false">Geist</button>
      <button type="button" data-face="hybrid" aria-pressed="false">Hybrid</button>
    </div>
  </div>
  <nav class="sg-wrap sg-toc" aria-label="Sections">
    <a href="#faces">Fraunces vs Geist</a><a href="#type">Type scale</a><a href="#colour">Colour</a><a href="#buttons">Buttons</a><a href="#cards">Cards</a><a href="#media">Media</a><a href="#system">Space · radii · icons</a><a href="#tailwind">Tailwind v4?</a>
  </nav>
</header>

<main class="sg-wrap">
  <p class="t-lead sg-intro">Tokens build on the existing hypsometric palette. Body is Geist, labels and data stay IBM Plex Mono. All samples use live copy. 34 font sizes become 9 steps, 8 radii become 3, and every text pair below is measured in the browser from the actual CSS.</p>

  <!-- 1 · FACES -->
  <section class="sg-sec" id="faces">
    <div class="sg-head"><span class="t-label">01 · Decision needed</span><h2 class="t-h2">Fraunces vs Geist for headings</h2>
      <p class="t-body">The same real headings, set both ways. Body text is Geist in both columns. The toggle at the top switches every heading on this page; “Hybrid” is my recommendation below.</p></div>

    <div class="cmp">
      {[['serif', 'Fraunces 500 · optical sizing · −0.012em'], ['sans', 'Geist 600 · −0.028em']].map(([face, spec]) => (
        <div class="cmp__col" data-heading={face}>
          <div class="cmp__spec t-meta">{spec}</div>

          <div class="cmp__hero on-dark">
            <div class="t-label" style="color:var(--inv-accent)">Earth Observation · 3D Forest Science</div>
            <div class="t-display cmp__display">Martin Mokroš</div>
            <p class="cmp__lede">I turn forests into point clouds and point clouds into things people can act on.</p>
          </div>

          <div class="cmp__block">
            <div class="t-label">What I do</div>
            <p class="t-h2">Turning 3D sensing into trusted forest measurements.</p>
          </div>

          <div class="cmp__block">
            <div class="t-label">Right now · Summer 2026</div>
            <h3 class="t-h2">In the field this season.</h3>
            <p class="t-lead">One method — low-cost 3D scanning — carried from UK inventory plots to city streets and tropical community forests.</p>
          </div>

          <div class="cmp__block">
            <h4 class="t-h3">We’re hiring: an 18-month postdoc on 3DTreePrint</h4>
            <p class="t-sm">Help put mobile laser scanning in the hands of total non-experts.</p>
          </div>

          <div class="cmp__block">
            <div class="t-label">Projects</div>
            <h3 class="t-h1">What I’m building.</h3>
            <p class="t-lead">Named, funded efforts with partners and a clock. Each links to the research it advances.</p>
          </div>

          {featured && (
            <div class="cmp__block">
              <div class="t-label">{featured.data.eyebrow}</div>
              <h4 class="t-h2">{featured.data.title}</h4>
              <p class="t-lead">{featured.data.subtitle}</p>
            </div>
          )}

          <div class="cmp__block cmp__strands">
            {strands.map((p) => (<div><span class="t-label">{p.data.tag}</span><span class="t-h4">{p.data.title}</span></div>))}
          </div>

          <div class="cmp__block cmp__stats">
            <div><span class="t-data">3,000+</span><span class="t-label" style="color:var(--text-muted)">Citations · Google Scholar</span></div>
            <div><span class="t-data">40+</span><span class="t-label" style="color:var(--text-muted)">Publications</span></div>
          </div>
        </div>
      ))}
    </div>

    <div class="sg-note">
      <b>My recommendation: Fraunces for h1–h3 and the hero name, Geist for everything at h4 and below</b> (card titles, list items, nav). Fraunces is what keeps this from reading as a SaaS template, and its optical sizing holds up at display sizes. Set in Geist the display headings look like every Vercel-template landing page, which is the look the brief rules out. Geist is the better face for short, dense UI headings (card titles, the strands list), where Fraunces at 20px looks bookish. If you’d rather have one face throughout, choose Fraunces. It’s two tokens either way: <code>--font-heading</code> for h1–h3 and <code>--font-title</code> for h4 and card titles. Pick “Hybrid” in the toggle to see it across the page.
    </div>
  </section>

  <!-- 2 · TYPE -->
  <section class="sg-sec" id="type">
    <div class="sg-head"><span class="t-label">02</span><h2 class="t-h2">Type scale</h2>
      <p class="t-body">Nine steps. Headings are fluid (<code>clamp()</code>) between 375 and ~1100px; body and UI text are fixed. The “now” column is measured at your current viewport.</p></div>
    <div class="scale">
      {scale.map(([tok, range, text, cls]) => (
        <div class="scale__row">
          <div class="scale__tok"><code>{tok}</code><span class="t-meta">{range}px · now <span class="js-px" data-cls={cls}>–</span></span></div>
          <div class={`${cls} scale__sample`}>{text}</div>
        </div>
      ))}
    </div>
    <div class="sg-grid3">
      <div><span class="t-label">Body</span><p class="t-sm">Geist 400/500/600 · 17px/1.6 · measure 64ch</p></div>
      <div><span class="t-label">Labels &amp; data</span><p class="t-sm">IBM Plex Mono 400/500 · 12px caps, +0.12em tracking · tabular numerals</p></div>
      <div><span class="t-label">Headings</span><p class="t-sm">Line-height 1.06 (display 1.0) · weight and tracking set by the face token</p></div>
    </div>
  </section>

  <!-- 3 · COLOUR -->
  <section class="sg-sec" id="colour">
    <div class="sg-head"><span class="t-label">03</span><h2 class="t-h2">Colour roles</h2>
      <p class="t-body">The palette is unchanged except for two refinements: <code>--ochre-ink</code> (ochre for text) and <code>--ink-soft</code>, nudged from #54624F to #505E4C. <code>--paper-0</code> is a lighter paper tint for card surfaces; it’s new, so it needs your OK. One accent: ochre fills things, ochre-ink writes things.</p></div>
    <div class="swatches">
      {swatches.map(([v, use]) => (
        <div class="swatch"><span class="swatch__chip" style={`background:var(${v})`}></span><code>{v}</code><span class="t-meta js-hex" data-var={v}>–</span><span class="t-sm">{use}</span></div>
      ))}
    </div>

    <h3 class="t-h4 sg-sub">Measured contrast</h3>
    <div class="pairs" role="table" aria-label="Contrast pairs">
      <div class="pairs__row pairs__hd" role="row"><span role="columnheader">Sample</span><span role="columnheader">Foreground / background</span><span role="columnheader">Role</span><span role="columnheader">Ratio</span><span role="columnheader">Verdict</span></div>
      {pairs.map(([fg, bg, role, kind]) => (
        <div class="pairs__row" role="row">
          <span role="cell"><span class={`pairs__sample js-pair ${kind === 'text' ? '' : 'is-ui'}`} data-kind={kind} style={`color:var(${fg});background:var(${bg})`}>{kind === 'text' ? 'Aa Forest' : ''}</span></span>
          <span role="cell"><code>{fg}</code> on <code>{bg}</code></span>
          <span role="cell" class="t-sm">{role}</span>
          <span role="cell" class="pairs__ratio">–</span>
          <span role="cell" class="pairs__verdict">–</span>
        </div>
      ))}
    </div>
    <p class="t-sm sg-fine">Thresholds (WCAG 2.2): text 4.5:1 (AA), UI boundaries and focus 3:1. “Fill only” rows are expected to fail: ochre <code>#BB7029</code> is kept for fills and rules, never for text or focus rings.</p>
  </section>

  <!-- 4 · BUTTONS -->
  <section class="sg-sec" id="buttons">
    <div class="sg-head"><span class="t-label">04</span><h2 class="t-h2">Buttons</h2>
      <p class="t-body">Two buttons and one arrow link. 44px minimum height, 8px radius (was 3px). Hover changes colour and nudges the arrow; nothing lifts or bounces. Proposal: the “→” at the end of labels becomes a Lucide arrow. The words stay the same.</p></div>
    {[['', 'On paper'], ['on-dark', 'On dark (hero, Hire me)']].map(([cls, title]) => (
      <div class={`btn-demo ${cls}`}>
        <span class="t-label" style={cls ? 'color:var(--inv-accent)' : ''}>{title}</span>
        {['', 'is-hover', 'is-focus'].map((st) => (
          <div class="btn-demo__row">
            <span class="t-meta btn-demo__state">{st ? st.replace('is-', '') : 'default'}</span>
            <a class={`button button--primary ${st}`} href="/collaborate">Work with me <Icon name="arrow-right" /></a>
            <a class={`button button--secondary ${st}`} href="/join">Join me <Icon name="arrow-right" /></a>
            <a class={`arrow-link ${st}`} href="/news">All news <Icon name="arrow-right" /></a>
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- 5 · CARDS -->
  <section class="sg-sec" id="cards">
    <div class="sg-head"><span class="t-label">05</span><h2 class="t-h2">Cards: two variants</h2>
      <p class="t-body"><b>Static</b>: no fill, hairline only, no hover, no pointer, no arrow. <b>Link</b>: a raised surface and the whole card is one link, with an always-visible arrow row, a stronger border on hover, an underlined title and a focus ring. “Featured” isn’t a third style: it’s the static card at a larger size with an ochre top rule, used only for the open call.</p></div>

    <article class="card card--feature">
      <div class="card__meta"><span class="tag">Open call · deadline 23 Oct 2026</span><span class="t-meta">3DTreePrint · ARIA · UCL Geography</span></div>
      <h3 class="card__title">We’re hiring: an 18-month postdoc on 3DTreePrint</h3>
      <p class="card__body">Help put mobile laser scanning in the hands of total non-experts. Our low-cost prototypes, built on the Livox Mid-360 with Janusz Będkowski (IPPT PAN), are already in use at Forestry England, Forestry and Land Scotland, Forest Research, Kew and with partners in Madagascar. You’ll work on the processing side, turning their scans into reliable tree and forest measurements.</p>
      <dl class="facts">
        <div><dt>Role</dt><dd>Research Fellow (postdoc)</dd></div>
        <div><dt>Start</dt><dd>1 Dec 2026 · 18 months, to 31 May 2028</dd></div>
        <div><dt>Skills</dt><dd>Forest point clouds (TLS/MLS) · SLAM · Python or C++</dd></div>
        <div><dt>Deadline</dt><dd>23 October 2026</dd></div>
      </dl>
      <div class="actions">
        <a class="button button--primary" href="https://www.ucl.ac.uk/work-at-ucl/search-ucl-jobs/details?jobId=48546&amp;jobTitle=Research+Fellow%3A++3DTreePrint+Project" target="_blank" rel="noopener">Read the advert &amp; apply <Icon name="arrow-up-right" /></a>
        <a class="arrow-link" href="mailto:m.mokros@ucl.ac.uk?subject=3DTreePrint%20postdoc"><Icon name="mail" /> Questions? Email me</a>
      </div>
    </article>

    <div class="card-grid">
      <article class="card">
        <div class="card__meta"><span class="tag">July</span><span class="t-meta">with Forest Research</span></div>
        <h3 class="card__title">UK National Forest Inventory — Thetford</h3>
        <p class="card__body">Scanning inventory and managed woodland to test whether low-cost handheld LiDAR can match the national standard.</p>
      </article>
      <article class="card">
        <div class="card__meta"><span class="tag">Summer</span><span class="t-meta">with Forest Research</span></div>
        <h3 class="card__title">Flux-tower footprint — Alice Holt</h3>
        <p class="card__body">Mapping the ~2.5&nbsp;ha footprint beneath a carbon flux tower in 3D, linking what the tower measures to the structure behind it.</p>
      </article>
      <a class="card card--link" href="/news/madagascar-handover">
        <div class="card__meta"><span class="tag">Aug 2026 · done</span><span class="t-meta">Scanning Together</span></div>
        <h3 class="card__title">Community scanning — Madagascar</h3>
        <p class="card__body">10 scanners under €2,000 handed over and 15+ people trained with local partners. Tanzania next, 8–20 November.</p>
        <span class="card__foot">Read the story <Icon name="arrow-right" /></span>
      </a>
      <a class="card card--link is-hover" href="/collaborate">
        <div class="card__meta"><span class="tag">Open invite</span><span class="t-meta">hover state</span></div>
        <h3 class="card__title">Want to try it?</h3>
        <p class="card__body">Curious about low-cost 3D scanning for your site, city or project? Get in touch and we’ll cook something up together.</p>
        <span class="card__foot">Work with me <Icon name="arrow-right" /></span>
      </a>
    </div>
  </section>

  <!-- 6 · MEDIA -->
  <section class="sg-sec" id="media">
    <div class="sg-head"><span class="t-label">06</span><h2 class="t-h2">Media frame</h2>
      <p class="t-body">One 16:9 frame with a hairline, 8px radius and a mono caption bar <em>below</em> the image instead of a gradient over it, so captions stay readable on bright footage. Potree loads only on click: a poster plus “Explore in 3D”. Without WebGL, the poster stays and a short note replaces the button.</p></div>
    <div class="media-grid">
      <figure class="media">
        <div class="media__stage"><img src="/media/ScanningTogether.jpg" alt="" /></div>
        <figcaption class="media__cap"><span><b>Concept</b> · Scanning Together</span><span>projec concept</span></figcaption>
      </figure>

      <figure class="media js-scan">
        <div class="media__stage">
          <img src="/media/scan-thumb.svg" alt="Still of the 3DTreePrint point cloud" />
          <div class="media__overlay">
            <button type="button" class="media__play js-load"><Icon name="box" /> Explore in 3D</button>
            <span class="media__note">3D viewer needs WebGL. Showing a still.</span>
          </div>
        </div>
        <figcaption class="media__cap"><span><b>Interactive 3D scan</b> · 3DTreePrint</span><span>drag to orbit · scroll to zoom · coloured by elevation</span></figcaption>
      </figure>

      <figure class="media no-webgl">
        <div class="media__stage">
          <img src="/media/scan-thumb.svg" alt="Still of the 3DTreePrint point cloud" />
          <div class="media__overlay">
            <button type="button" class="media__play" tabindex="-1"><Icon name="box" /> Explore in 3D</button>
            <span class="media__note">3D viewer needs WebGL. Showing a still.</span>
          </div>
        </div>
        <figcaption class="media__cap"><span><b>Interactive 3D scan</b> · fallback state (forced)</span><span>no WebGL</span></figcaption>
      </figure>
    </div>
    <p class="t-sm sg-fine">The poster here is the existing <code>scan-thumb.svg</code> placeholder. For step 4 I’d capture a real still of the scan into <code>public/posters/</code>, since <code>public/media/</code> is off-limits. The WebGL note is new micro-copy and needs your OK.</p>
  </section>

  <!-- 7 · SYSTEM -->
  <section class="sg-sec" id="system">
    <div class="sg-head"><span class="t-label">07</span><h2 class="t-h2">Space, radii, motion, icons</h2></div>
    <div class="sg-grid2">
      <div>
        <h3 class="t-h4 sg-sub">Space · 4px base</h3>
        {space.map((s) => (<div class="space-row"><code>{s}</code><span class="space-bar" style={`width:var(${s})`}></span><span class="t-meta js-len" data-var={s}>–</span></div>))}
        <p class="t-sm sg-fine"><code>--section</code> 56 → 112px vertical rhythm. <code>--gutter</code> 16 → 32px side padding (16px on phones).</p>
      </div>
      <div>
        <h3 class="t-h4 sg-sub">Radii · 3</h3>
        <div class="radii">
          <div><span class="radius-box" style="border-radius:var(--r-1)"></span><code>--r-1</code><span class="t-meta">4px · tags, chips</span></div>
          <div><span class="radius-box" style="border-radius:var(--r-2)"></span><code>--r-2</code><span class="t-meta">8px · buttons, cards, media</span></div>
          <div><span class="radius-box" style="border-radius:var(--r-full)"></span><code>--r-full</code><span class="t-meta">pills, the brand dot</span></div>
        </div>
        <h3 class="t-h4 sg-sub">Motion</h3>
        <p class="t-sm"><code>--dur-1</code> 120ms colour changes · <code>--dur-2</code> 220ms arrow nudges · one ease curve. Under <code>prefers-reduced-motion</code> both durations drop to 0. No REC blink, no ticking coordinates, no hover lifts.</p>
      </div>
    </div>
    <h3 class="t-h4 sg-sub">Icons · Lucide subset, inlined (no dependency)</h3>
    <div class="icons">
      {icons.map(([n, use]) => (<div class="icon-row"><Icon name={n} /><code>{n}</code><span class="t-sm">{use}</span></div>))}
    </div>
  </section>

  <!-- 8 · TAILWIND -->
  <section class="sg-sec" id="tailwind">
    <div class="sg-head"><span class="t-label">08</span><h2 class="t-h2">Tailwind v4? I recommend against it.</h2></div>
    <div class="sg-grid2 tw">
      <div>
        <h3 class="t-h4 sg-sub">Why not, for this site</h3>
        <ul class="t-body sg-list">
          <li><b>Scale.</b> 9 pages, 5 components and one ~330-line stylesheet. The token system above is about 60 lines of custom properties, which is the main thing v4’s <code>@theme</code> would give us anyway.</li>
          <li><b>Diff risk.</b> Moving to utilities rewrites the markup of every <code>.astro</code> file. That cuts against “small, separate commits” and makes accidental copy or link edits harder to spot in review.</li>
          <li><b>Markdown.</b> <code>src/content/</code> renders plain HTML that can’t carry utility classes, so we’d still need hand-written prose styles (or the typography plugin) next to Tailwind.</li>
          <li><b>Bespoke look.</b> The brief rules out a generic SaaS look, and Tailwind’s defaults (spacing, greys, radii, shadows) pull toward it unless we override most of them.</li>
          <li><b>Toolchain.</b> It adds <code>tailwindcss</code> + <code>@tailwindcss/vite</code> to a project with two dependencies, on Astro 4 / Vite 5. That’s workable but not free, and another thing to keep upgrading.</li>
        </ul>
      </div>
      <div>
        <h3 class="t-h4 sg-sub">What I’d do instead</h3>
        <ul class="t-body sg-list">
          <li>Keep plain CSS with these tokens. Split <code>global.css</code> into <code>tokens</code> / <code>base</code> / <code>components</code> with <code>@layer</code>, and move page-only rules into scoped Astro <code>&lt;style&gt;</code> blocks.</li>
          <li>Remove the 13 inline styles in favour of the spacing tokens.</li>
          <li>Reconsider Tailwind only if the site grows into a multi-author product with many repeated layouts. That’s when shared utilities start paying for themselves.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sg-sec sg-copy">
    <span class="t-label">Noticed, not touched (copy is off-limits)</span>
    <p class="t-sm">Typos in live copy: “Urban Tree <b>Inteligence</b>” (hero feed label) and “3D Urban <b>Inteligence</b>” (reel), “<b>projec</b> concept” (reel caption), “We’re open<b> here’s</b> how” (Home teaser, missing punctuation). Tell me if you want them fixed.</p>
  </section>
</main>

<style is:global>
  body{font-family:var(--font-sans);font-size:var(--fs-base);line-height:var(--lh-body);background:var(--bg);color:var(--text)}
  code{font-family:var(--font-mono);font-size:.86em;background:var(--bg-alt);padding:1px 5px;border-radius:var(--r-1);color:var(--text)}
  .sg-wrap{max-width:var(--container);margin:0 auto;padding-inline:var(--gutter)}
  .sg-top{position:sticky;top:0;z-index:10;background:rgba(233,225,210,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .sg-top__row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--s-3);padding-block:var(--s-4) var(--s-2)}
  .sg-title{font-size:clamp(24px,2vw + 16px,32px)}
  .sg-toggle{display:flex;align-items:center;gap:var(--s-2)}
  .sg-toggle button{font:500 14px/1 var(--font-sans);min-height:36px;padding:0 var(--s-4);border:1px solid var(--line-strong);border-radius:var(--r-2);background:transparent;color:var(--text);cursor:pointer}
  .sg-toggle button[aria-pressed="true"]{background:var(--text);color:var(--paper);border-color:var(--text)}
  .sg-toggle button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
  .sg-toc{display:flex;gap:var(--s-4);overflow-x:auto;padding-block:var(--s-2) var(--s-3);font:400 13px/1.4 var(--font-mono);scrollbar-width:none}
  .sg-toc a{color:var(--text-muted);text-decoration:none;white-space:nowrap}
  .sg-toc a:hover{color:var(--text-accent)}
  .sg-intro{margin-top:var(--s-7)}
  .sg-sec{padding:var(--section) 0 0}
  .sg-sec:last-child{padding-bottom:var(--section)}
  .sg-head{display:grid;gap:var(--s-3);margin-bottom:var(--s-6);max-width:72ch}
  .sg-sub{margin:var(--s-6) 0 var(--s-3);font-family:var(--font-sans);font-weight:600;letter-spacing:-.01em}
  .sg-fine{margin-top:var(--s-4);max-width:80ch}
  .sg-note{margin-top:var(--s-6);padding:var(--s-5);border-left:3px solid var(--accent);background:var(--surface);border-radius:0 var(--r-2) var(--r-2) 0;max-width:80ch;color:var(--text-muted)}
  .sg-note b{color:var(--text)}
  .sg-grid2{display:grid;gap:var(--s-6)}
  .sg-grid3{display:grid;gap:var(--s-5);margin-top:var(--s-6)}
  .sg-grid3 .t-label{display:block;margin-bottom:var(--s-1)}
  @media(min-width:800px){.sg-grid2{grid-template-columns:1fr 1fr}.sg-grid3{grid-template-columns:repeat(3,1fr)}}
  .sg-list{padding-left:1.1em;display:grid;gap:var(--s-3)}
  .sg-list b{color:var(--text)}
  .sg-copy{border-top:1px solid var(--line);margin-top:var(--section);padding-top:var(--s-6)}
  .sg-copy .t-label{display:block;margin-bottom:var(--s-2)}

  /* comparison */
  .cmp{display:grid;gap:var(--s-5)}
  @media(min-width:900px){.cmp{grid-template-columns:1fr 1fr}}
  .cmp__col{container-type:inline-size;min-width:0;display:grid;gap:var(--s-6);align-content:start;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-2);padding:var(--s-5)}
  .cmp__spec{border-bottom:1px solid var(--line);padding-bottom:var(--s-3)}
  .cmp__hero{background:var(--inv-bg);border-radius:var(--r-2);padding:var(--s-6) var(--s-5)}
  .cmp__hero .cmp__display{color:var(--inv-text);font-size:min(var(--fs-display),13cqi);margin:var(--s-3) 0}
  .cmp__lede{color:var(--inv-muted);font-size:var(--fs-lead);line-height:1.45;max-width:36ch}
  .cmp__block{display:grid;gap:var(--s-3)}
  .cmp__block .t-h1{font-size:min(var(--fs-h1),10cqi)}
  .cmp__strands{gap:var(--s-4)}
  .cmp__strands>div{display:grid;gap:var(--s-1);border-top:1px solid var(--line);padding-top:var(--s-3)}
  .cmp__stats{grid-template-columns:1fr 1fr}
  .cmp__stats>div{display:grid;gap:var(--s-2)}

  /* type scale */
  .scale{border-top:1px solid var(--line)}
  .scale__row{display:grid;gap:var(--s-2) var(--s-6);padding:var(--s-5) 0;border-bottom:1px solid var(--line);align-items:baseline}
  @media(min-width:800px){.scale__row{grid-template-columns:220px 1fr}}
  .scale__tok{display:grid;gap:var(--s-1)}
  .scale__tok code{justify-self:start}
  .scale__sample{min-width:0;overflow-wrap:anywhere}

  /* colour */
  .swatches{display:grid;gap:var(--s-3);grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .swatch{display:grid;gap:var(--s-1);align-content:start}
  .swatch code{justify-self:start}
  .swatch__chip{height:64px;border-radius:var(--r-2);border:1px solid var(--line);margin-bottom:var(--s-1)}
  .pairs{border-top:1px solid var(--line)}
  .pairs__row{display:grid;grid-template-columns:96px auto 1fr;gap:var(--s-1) var(--s-4);align-items:center;padding:var(--s-3) 0;border-bottom:1px solid var(--line);font-size:var(--fs-sm)}
  .pairs__row>*{min-width:0}
  .pairs__row>:nth-child(1){grid-row:1/4}
  .pairs__row>:nth-child(2),.pairs__row>:nth-child(3){grid-column:2/4}
  @media(min-width:900px){.pairs__row{grid-template-columns:110px 1.3fr 1fr 80px 100px;padding:var(--s-2) 0}.pairs__row>*{grid-column:auto!important;grid-row:auto!important}}
  .pairs__hd{display:none;font:500 11px/1.3 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted)}
  @media(min-width:900px){.pairs__hd{display:grid}}
  .pairs__sample{display:inline-flex;align-items:center;justify-content:center;width:96px;height:40px;border-radius:var(--r-1);font:500 15px/1 var(--font-sans);border:1px solid var(--line)}
  .pairs__sample.is-ui{background-image:none;box-shadow:inset 0 0 0 2px currentColor}
  .pairs__ratio{font:500 14px/1 var(--font-mono);font-variant-numeric:tabular-nums}
  .pairs__verdict{font:500 11px/1.2 var(--font-mono);letter-spacing:.06em;text-transform:uppercase}
  .pairs__verdict.pass{color:var(--forest)}
  .pairs__verdict.fail{color:#9B2C1F}
  .pairs__verdict.decor{color:var(--text-muted)}

  /* buttons */
  .btn-demo{display:grid;gap:var(--s-3);padding:var(--s-5);border:1px solid var(--line);border-radius:var(--r-2);margin-bottom:var(--s-4)}
  .btn-demo.on-dark{background:var(--inv-bg);border-color:var(--inv-bg)}
  .btn-demo__row{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s-3) var(--s-5)}
  .btn-demo__state{width:64px}
  .on-dark .btn-demo__state{color:var(--inv-muted)}

  /* cards */
  .card-grid{display:grid;gap:var(--s-4);margin-top:var(--s-4)}
  @media(min-width:640px){.card-grid{grid-template-columns:1fr 1fr}}
  @media(min-width:1040px){.card-grid{grid-template-columns:repeat(4,1fr)}}

  /* media */
  .media-grid{display:grid;gap:var(--s-5);align-items:start}
  @media(min-width:900px){.media-grid{grid-template-columns:1fr 1fr}.media-grid>:first-child{grid-column:1/-1}}

  /* system */
  .space-row{display:grid;grid-template-columns:64px 1fr 48px;gap:var(--s-3);align-items:center;padding:6px 0}
  .space-bar{height:12px;background:var(--forest);border-radius:2px}
  .radii{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s-4)}
  .radii>div{display:grid;gap:var(--s-1);justify-items:start}
  .radius-box{width:72px;height:48px;background:var(--surface);border:1.5px solid var(--line-strong)}
  .icons{display:grid;gap:var(--s-2) var(--s-6)}
  @media(min-width:800px){.icons{grid-template-columns:1fr 1fr}}
  .icon-row{display:grid;grid-template-columns:24px 130px 1fr;gap:var(--s-3);align-items:center;color:var(--text)}
  .icon-row .icon{width:20px;height:20px}
  .tw .sg-sub{margin-top:0}
</style>

<script is:inline>
  // heading-face toggle (remembered per browser)
  const root = document.documentElement;
  const btns = document.querySelectorAll('.sg-toggle button');
  function setFace(f) {
    root.dataset.heading = f;
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.face === f)));
    try { localStorage.setItem('sg-face', f); } catch (e) {}
    measureType();
  }
  btns.forEach((b) => b.addEventListener('click', () => setFace(b.dataset.face)));

  // live px for each type step
  function measureType() {
    document.querySelectorAll('.js-px').forEach((el) => {
      const s = el.closest('.scale__row').querySelector('.scale__sample');
      el.textContent = Math.round(parseFloat(getComputedStyle(s).fontSize)) + 'px';
    });
  }
  addEventListener('resize', measureType);

  // WCAG contrast, measured from the rendered CSS
  const rgb = (c) => c.match(/[\d.]+/g).slice(0, 3).map(Number);
  const lum = (c) => {
    const [r, g, b] = rgb(c).map((v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const ratio = (a, b) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
  const hex = (c) => '#' + rgb(c).map((v) => Math.round(v).toString(16).padStart(2, '0')).join('').toUpperCase();
  document.querySelectorAll('.js-pair').forEach((el) => {
    const cs = getComputedStyle(el);
    const r = ratio(cs.color, cs.backgroundColor);
    const row = el.closest('.pairs__row');
    row.querySelector('.pairs__ratio').textContent = r.toFixed(2) + ':1';
    const v = row.querySelector('.pairs__verdict');
    const kind = el.dataset.kind;
    if (kind === 'decor') { v.textContent = 'Fill only'; v.classList.add('decor'); return; }
    const min = kind === 'ui' ? 3 : 4.5;
    const pass = r >= min;
    v.textContent = pass ? (kind === 'ui' ? 'Pass · 3:1' : r >= 7 ? 'AAA' : 'AA') : 'Fail';
    v.classList.add(pass ? 'pass' : 'fail');
  });

  // resolved values for swatches and spacing
  const probe = document.createElement('span');
  document.body.appendChild(probe);
  document.querySelectorAll('.js-hex').forEach((el) => {
    probe.style.color = `var(${el.dataset.var})`;
    el.textContent = hex(getComputedStyle(probe).color);
  });
  probe.remove();
  document.querySelectorAll('.js-len').forEach((el) => {
    el.textContent = getComputedStyle(root).getPropertyValue(el.dataset.var).trim();
  });

  // Potree: click-to-load; poster doubles as the no-WebGL fallback
  const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch (e) { return false; } })();
  document.querySelectorAll('.js-scan').forEach((fig) => {
    if (!gl) { fig.classList.add('no-webgl'); return; }
    fig.querySelector('.js-load').addEventListener('click', () => {
      const stage = fig.querySelector('.media__stage');
      stage.innerHTML = '<iframe src="/potree/embed.html" title="Interactive 3D point cloud — 3DTreePrint scan" allowfullscreen></iframe>';
      stage.querySelector('iframe').focus();
    });
  });

  let saved = 'serif';
  try { saved = localStorage.getItem('sg-face') || 'serif'; } catch (e) {}
  if (!['serif', 'sans', 'hybrid'].includes(saved)) saved = 'serif';
  setFace(saved);
</script>
</body>
</html>
