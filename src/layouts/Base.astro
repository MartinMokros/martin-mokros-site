---
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/v2.css';
import '../styles/components.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';

const {
  title = 'Martin Mokroš — Earth Observation',
  description = 'Martin Mokroš — Lecturer in Earth Observation at UCL, NCEO Fellow and ARIA Creator; chaired 3DForEcoTech (2021–25). Turning forests into point clouds, and point clouds into decisions.',
  home = false,
  v2 = false, // redesigned page: Geist body + new components (rolling out page by page)
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet" />
</head>
<body class={v2 ? 'v2' : undefined}>
  <Nav home={home} />
  <main>
    <slot />
  </main>
  <Footer v2={v2} />
  {v2 && <Reveal />}
</body>
</html>
