---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Reel from '../components/Reel.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { stats, statsAsOf } from '../data/stats';

const notes = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = notes.slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

// The point-cloud band only renders once the real render exists.
// EDIT: add public/posters/pointcloud-band.webp (elevation-coloured point-cloud render, ~2400×800).
const hasCloud = existsSync(path.join(process.cwd(), 'public/posters/pointcloud-band.webp'));
---
<Base home={true} v2={true}>
  <Hero />

  <!-- WHAT I DO -->
  <section class="intro">
    <div class="wrap g12">
      <div class="intro__head reveal">
        <div class="t-label">What I do</div>
        <p class="intro__statement">Turning 3D sensing into trusted forest measurements.</p>
      </div>
      <p class="t-body intro__body reveal">I'm an Earth observation scientist at UCL working to make three-dimensional forest measurement practical beyond the research lab. Over the past decade, I've worked with many laser scanning systems, from terrestrial and mobile LiDAR to UAV and smartphone sensors, and learned that no single technology is the answer. Reliable measurements come from the entire pipeline: designing sensors, collecting data, benchmarking hardware and software, developing processing workflows, and working with foresters, ecologists and city managers to ensure the results answer real-world questions. My goal is to turn emerging technologies into <em>trusted, affordable and open</em> solutions that anyone can use to understand forests better.</p>
      <div class="proofs reveal">
        <div class="card proof"><h3 class="card__title">End-to-end expertise</h3><p class="card__body">Working across the complete measurement pipeline: prototype development, field acquisition, benchmarking, processing, ecological interpretation and operational deployment.</p></div>
        <div class="card proof"><h3 class="card__title">International benchmarks</h3><p class="card__body">Leading independent evaluations of forest scanning technologies and processing pipelines, helping researchers and practitioners choose methods based on evidence rather than marketing.</p></div>
        <div class="card proof"><h3 class="card__title">Building global expertise</h3><p class="card__body">Designed and delivered more than 10 international summer schools and workshops, training hundreds of researchers, practitioners and students from around the world in modern forest measurement and Earth observation.</p></div>
        <div class="card proof"><h3 class="card__title">Open science &amp; standards</h3><p class="card__body">Chaired 3DForEcoTech 2021–25 (600+ scientists across 60+ countries) and pushing open data, shared protocols and reproducible workflows so results are comparable, not siloed. <a class="text-link" href="https://www.ucl.ac.uk/social-historical-sciences/news/2025/oct/ucl-geography-lecturer-wins-open-science-award-global-collaboration-forest-research" target="_blank" rel="noopener">UCL Open Science Award, 2025</a>.</p></div>
      </div>
    </div>
  </section>

  <!-- NUMBERS BAND — point-cloud render above, figures on solid --shadow below -->
  <section class={`figures on-dark${hasCloud ? ' figures--cloud' : ''}`} aria-label="In numbers">
    {hasCloud && <img class="figures__cloud" src="/posters/pointcloud-band.webp" alt="" width="2400" height="800" loading="lazy" />}
    <div class="wrap g12">
      <dl class="figures__list reveal">
        {stats.map((f) => (
          <div>
            <dt><span class="figures__label">{f.label}</span><span class="t-label figures__scope">{f.scope}</span></dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <p class="t-label figures__asof">As of {statsAsOf}</p>
    </div>
  </section>

  <!-- RIGHT NOW -->
  <section class="now">
    <div class="wrap g12">
      <div class="now__head reveal">
        <div class="t-label">Right now · Autumn 2026</div>
        {/* EDIT: the entries below are now finished; "this season" may need new wording for autumn. */}
        <h2 class="t-h2">In the field this season.</h2>
      </div>
      <p class="t-lead now__lede reveal">One method — low-cost 3D scanning — carried from UK inventory plots to city streets and tropical community forests.</p>

      <article class="card card--feature now__call reveal" data-closes="2026-10-24T00:00:00+01:00">
        <div class="card__meta"><span class="badge js-status">Open call · deadline 23 Oct 2026</span><span class="t-meta">3DTreePrint · ARIA · UCL Geography</span></div>
        <div class="now__call-grid">
          <div class="now__call-text">
            <h3 class="card__title">We're hiring: an 18-month postdoc on 3DTreePrint</h3>
            <p class="card__body">Help put mobile laser scanning in the hands of total non-experts. Our low-cost prototypes, built on the Livox Mid-360 with Janusz Będkowski (IPPT PAN), are already in use at Forestry England, Forestry and Land Scotland, Forest Research, Kew and with partners in Madagascar. You'll work on the processing side, turning their scans into reliable tree and forest measurements.</p>
            <div class="actions">
              <a class="button button--primary js-apply" href="https://www.ucl.ac.uk/work-at-ucl/search-ucl-jobs/details?jobId=48546&amp;jobTitle=Research+Fellow%3A++3DTreePrint+Project" target="_blank" rel="noopener">Read the advert &amp; apply <Icon name="arrow-up-right" /></a>
              <a class="arrow-link" href="mailto:m.mokros@ucl.ac.uk?subject=3DTreePrint%20postdoc">Questions? Email me <Icon name="arrow-right" /></a>
            </div>
          </div>
          <dl class="facts">
            <div><dt>Role</dt><dd>Research Fellow (postdoc)</dd></div>
            <div><dt>Start</dt><dd>1 Dec 2026 · 18 months, to 31 May 2028</dd></div>
            <div><dt>Skills</dt><dd>Forest point clouds (TLS/MLS) · SLAM · Python or C++</dd></div>
            <div><dt>Deadline</dt><dd>23 October 2026</dd></div>
          </dl>
        </div>
      </article>

      <div class="now__log reveal">
        {/* EDIT: past tense, Autumn 2026. Is processing finished? If results are out, say where; if not, say when. */}
        <article class="card">
          <div class="card__meta"><span class="badge">June 2026 · done</span><span class="t-meta">COST Action INTUF · Bratislava</span></div>
          <h3 class="card__title">3D Urban Tree Intelligence</h3>
          <p class="card__body">In June we ran a city-scale scanning testbed in Bratislava — <b>28 scanners</b> capturing <b>1,000+ trees</b>. Over the summer we aligned, clipped and cleaned the data and prepared the evidence and evaluation.</p>
          <a class="arrow-link" href="https://martinmokros.github.io/3D-Urban-Tree-Intelligence/" target="_blank" rel="noopener">Visit the project site <Icon name="arrow-up-right" /></a>
          <p class="t-sm">Want the results? Sign up for the newsletter there, or <a class="text-link" href="mailto:m.mokros@ucl.ac.uk">email me</a>.</p>
        </article>
        {/* EDIT: past tense, Autumn 2026. Add the outcome once known (did it match the national standard?). */}
        <article class="card">
          <div class="card__meta"><span class="badge">July 2026 · done</span><span class="t-meta">with Forest Research</span></div>
          <h3 class="card__title">UK National Forest Inventory — Thetford</h3>
          <p class="card__body">Scanned inventory and managed woodland to test whether low-cost handheld LiDAR can match the national standard.</p>
        </article>
        {/* EDIT: past tense, Autumn 2026. Confirm it finished this summer; add the outcome once known. */}
        <article class="card">
          <div class="card__meta"><span class="badge">Summer 2026 · done</span><span class="t-meta">with Forest Research</span></div>
          <h3 class="card__title">Flux-tower footprint — Alice Holt</h3>
          <p class="card__body">Mapped the ~2.5&nbsp;ha footprint beneath a carbon flux tower in 3D, linking what the tower measures to the structure behind it.</p>
        </article>
        {/* EDIT: past tense, Autumn 2026. Confirm it finished this summer; add the outcome once known. */}
        <article class="card">
          <div class="card__meta"><span class="badge">Summer 2026 · done</span><span class="t-meta">with Earthwatch Europe</span></div>
          <h3 class="card__title">Miyawaki micro-forests — Oxford</h3>
          <p class="card__body">Scanned the UK's oldest tiny forests to see how dense, engineered woodland actually grows.</p>
        </article>
      </div>
      <div class="now__links reveal">
        <a class="card card--link" href="/news/madagascar-handover">
          <div class="card__meta"><span class="badge">Aug 2026 · done</span><span class="t-meta">Scanning Together</span></div>
          <h3 class="card__title">Community scanning — Madagascar</h3>
          <p class="card__body">10 scanners under €2,000 handed over and 15+ people trained with local partners. Tanzania next, 8–20 November.</p>
          <span class="card__foot">Read the story <Icon name="arrow-right" /></span>
        </a>
        <a class="card card--link" href="/collaborate">
          <div class="card__meta"><span class="badge">Open invite</span></div>
          <h3 class="card__title">Want to try it?</h3>
          <p class="card__body">Curious about low-cost 3D scanning for your site, city or project? Get in touch and we'll cook something up together.</p>
          <span class="card__foot">Work with me <Icon name="arrow-right" /></span>
        </a>
      </div>
      <p class="t-meta now__partners">Funded by <b>ARIA</b> (3DTreePrint) and <b>NCEO</b> (Scanning Together). In collaboration with Forest Research, Earthwatch Europe, the Polish Academy of Sciences and the University of Zurich.</p>
    </div>
  </section>

  <!-- SCAN & FIELD REEL — full-bleed dark band -->
  <section class="reel-band on-dark">
    <div class="wrap g12">
      <div class="reel-band__head reveal">
        <div class="t-label">What we're doing</div>
        <h2 class="t-h2">Some videos and images to explore.</h2>
      </div>
      <p class="t-lead reel-band__lede reveal">Recent campaigns, scans, documentaries or concepts. New clips drop in as we collect them.</p>
      <div class="reel-band__media"><Reel /></div>
    </div>
  </section>

  <!-- NEWS & NOTES -->
  <section class="latest">
    <div class="wrap g12">
      <div class="latest__head reveal">
        <div class="t-label">NEWS</div>
        <h2 class="t-h2">Latest.</h2>
        <a class="arrow-link" href="/news">All news <Icon name="arrow-right" /></a>
      </div>
      <ul class="rows news reveal">
        {latest.map((n) => (
          <li><a class="linkrow" href={`/news/${n.slug}`}>
            <span class="linkrow__meta"><span class="t-meta">{fmt(n.data.date)}</span><span class="t-label">{n.data.tag}</span></span>
            <span class="linkrow__text"><span class="card__title">{n.data.title}</span><span class="card__body">{n.data.summary}</span></span>
            <Icon name="arrow-right" />
          </a></li>
        ))}
      </ul>
      <div class="teasers reveal">
        <a class="card card--link" href="/projects"><div class="t-label">FLAGSHIP</div><h3 class="card__title">3DTreePrint</h3><p class="card__body">My ARIA project: low-cost 3D "structural fingerprints" for ecosystem resilience.</p><span class="card__foot">Projects <Icon name="arrow-right" /></span></a>
        <a class="card card--link" href="/research"><div class="t-label">RESEARCH</div><h3 class="card__title">The why</h3><p class="card__body">The threads beneath the projects and why measuring forests in 3D matters.</p><span class="card__foot">Research <Icon name="arrow-right" /></span></a>
        <a class="card card--link" href="/join"><div class="t-label">JOIN US</div><h3 class="card__title">PhD &amp; postdoc</h3><p class="card__body">Funded, self-funded, or bringing your own. We're open — here's how.</p><span class="card__foot">Join us <Icon name="arrow-right" /></span></a>
      </div>
    </div>
  </section>

<style>
  /* ---------- what I do: statement left, body offset right ---------- */
  .intro__head{display:grid;gap:var(--s-4);align-content:start}
  .intro__statement{font-family:var(--font-heading);font-variation-settings:var(--heading-variation);font-weight:500;font-size:var(--fs-h2);line-height:1.02;letter-spacing:-.01em;color:var(--text);text-wrap:balance}
  .intro__body{margin-top:var(--s-6)}
  .proofs{display:grid;gap:var(--s-6) var(--s-5);margin-top:var(--s-8);counter-reset:proof}
  @media(min-width:640px){.proofs{grid-template-columns:1fr 1fr}}
  .proof{counter-increment:proof}
  .proof::before{content:"0" counter(proof);font:400 var(--fs-label)/1 var(--font-mono);letter-spacing:var(--tracking-label);color:var(--text-accent)}
  @media(min-width:960px){
    .intro__head{grid-column:1/7}
    .intro__body{grid-column:8/13;margin-top:0;padding-top:calc(var(--fs-label) * 1.4 + var(--s-4))}
    .proofs{grid-column:1/13;grid-template-columns:repeat(4,1fr)}
  }

  /* ---------- numbers band ---------- */
  .figures{background:var(--inv-bg);color:var(--inv-text);padding:var(--section) 0}
  .figures--cloud{padding-top:0}
  .figures__cloud{display:block;width:100%;height:clamp(160px,24vw,380px);object-fit:cover;
    -webkit-mask-image:linear-gradient(180deg,#000 55%,transparent);mask-image:linear-gradient(180deg,#000 55%,transparent)}
  .figures__list{display:grid;gap:var(--s-6) var(--s-5);margin:0}
  .figures__list>div{display:flex;flex-direction:column-reverse;justify-content:flex-end;gap:var(--s-3);border-top:1px solid var(--inv-line);padding-top:var(--s-4);min-width:0}
  .figures__list dt{display:grid;gap:var(--s-2)}
  .figures__label{font:500 15px/1.4 var(--font-sans);color:var(--inv-text);max-width:28ch}
  .figures__scope{color:var(--inv-muted);letter-spacing:.06em;line-height:1.45}
  .figures__list dd{margin:0;display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 10px;font:600 clamp(44px,10vw,64px)/.95 var(--font-sans);letter-spacing:-.035em;font-variant-numeric:tabular-nums;color:var(--inv-text);white-space:nowrap}
  .figures__asof{margin-top:var(--s-6);color:var(--inv-muted)}
  @media(min-width:640px){.figures__list{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(min-width:960px){
    .figures__list{grid-template-columns:repeat(3,minmax(0,1fr))}
    .figures__list dd{font-size:clamp(48px,4.4vw,72px)}
  }
  @media(min-width:960px){.figures__asof{text-align:right}}

  /* ---------- right now: big H2 left, lede right ---------- */
  .now{background:var(--bg-alt)}
  .now__head{display:grid;gap:var(--s-3)}
  .now__lede{margin-top:var(--s-4)}
  .now__call{margin-top:var(--s-7)}
  .now__call-grid{display:grid;gap:var(--s-6)}
  .now__call-text{display:grid;gap:var(--s-4);align-content:start}
  .now__call-text .actions{margin-top:var(--s-2)}
  .now__log{display:grid;gap:var(--s-6);margin-top:var(--s-7)}
  /* static entries flow in two columns instead of equal-height rows */
  @media(min-width:640px){.now__log{display:block;columns:2;column-gap:var(--s-5)}.now__log>.card{break-inside:avoid;margin-bottom:var(--s-6)}}
  .now__links{display:grid;gap:var(--s-4);align-content:start;margin-top:var(--s-7)}
  @media(min-width:640px) and (max-width:959px){.now__links{grid-template-columns:1fr 1fr}}
  .now .card__body b{color:var(--text);font-weight:600}
  .now__partners{margin-top:var(--s-7);max-width:72ch;font-size:12.5px;line-height:1.7}
  .now__partners b{color:var(--text);font-weight:500}
  @media(min-width:960px){
    .now__head{grid-column:1/8}
    .now__lede{grid-column:8/13;align-self:end;margin:0}
    .now__call{grid-column:2/13}
    .now__call-grid{grid-template-columns:3fr 2fr;gap:var(--s-7)}
    .now__log{grid-column:1/9}
    .now__links{grid-column:9/13}
    .now__partners{grid-column:1/9}
  }

  /* ---------- reel: full-bleed dark ---------- */
  .reel-band{background:var(--inv-bg);color:var(--inv-text)}
  .reel-band .t-h2{color:var(--inv-text)}
  .reel-band .t-label{color:var(--inv-accent)}
  .reel-band__head{display:grid;gap:var(--s-3)}
  .reel-band__lede{color:var(--inv-muted);margin-top:var(--s-4)}
  .reel-band__media{margin-top:var(--s-7)}
  @media(min-width:960px){
    .reel-band__head{grid-column:1/8}
    .reel-band__lede{grid-column:8/13;align-self:end;margin:0}
  }

  /* ---------- latest: list offset to the right, teasers full width ---------- */
  .latest__head{display:grid;gap:var(--s-3);justify-items:start;align-content:start}
  .news{margin-top:var(--s-6)}
  .teasers{display:grid;gap:var(--s-4);margin-top:var(--s-8)}
  @media(min-width:760px){.teasers{grid-template-columns:repeat(3,1fr)}}
  @media(min-width:960px){
    .latest__head{grid-column:1/4;position:sticky;top:calc(var(--nav-h) + var(--s-5));align-self:start}
    .news{grid-column:4/13;margin-top:0}
    .teasers{grid-column:1/13}
  }
</style>
<script is:inline>
  // Flip open calls to "closed" after their deadline, without a redeploy.
  document.querySelectorAll('[data-closes]').forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.closes)) {
      el.classList.add('closed');
      el.querySelectorAll('.js-status').forEach((s) => (s.textContent = 'Applications closed'));
    }
  });
</script>
</Base>
