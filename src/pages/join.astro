---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

const fellowships = [
  { label: 'UKRI / NERC fellowships', href: 'https://www.ukri.org/councils/nerc/' },
  { label: 'Leverhulme Early Career', href: 'https://www.leverhulme.ac.uk/early-career-fellowships' },
  { label: 'Marie Skłodowska-Curie (MSCA)', href: 'https://marie-sklodowska-curie-actions.ec.europa.eu/' },
  { label: 'Newton International', href: 'https://www.thebritishacademy.ac.uk/funding/newton-international-fellowships/' },
  { label: 'Royal Society URF', href: 'https://royalsociety.org/grants/university-research/' },
];
---
<Base title="Join us — Martin Mokroš" v2={true}>
  <PageHead label="Join us" title="Want to do a PhD or postdoc with me?">Short version: if your interests overlap with mine, get in touch early before any deadline. Funded, self-funded, or bringing funding from your own country: all welcome. Here's the how.</PageHead>
  <section class="join"><div class="wrap g12">
    <article class="card card--feature join__call reveal" id="postdoc" data-closes="2026-10-24T00:00:00+01:00">
      <div class="card__meta"><span class="badge js-status">Open now · deadline 23 Oct 2026</span></div>
      <h2 class="card__title">Research Fellow (postdoc): 3DTreePrint</h2>
      <p class="card__body">An 18-month postdoc at UCL Geography within 3DTreePrint, our ARIA-funded project on democratising and scaling mobile laser scanning for monitoring trees and forests, so that people with no scanning background can use it. It's applied research: our low-cost prototypes are already with foresters, farmers and researchers in the UK and Madagascar, together with our sister projects Scanning Together (UCL) and Scanning4Africa (University of Zurich). You'll work on the processing side.</p>
      <p class="card__body"><b>You'll need</b> experience with forest point clouds (TLS/MLS), SLAM, and Python or C++. Starts 1 December 2026; funded for 18 months, to 31 May 2028.</p>
      <div class="actions">
        <a class="button button--primary js-apply" href="https://www.ucl.ac.uk/work-at-ucl/search-ucl-jobs/details?jobId=48546&amp;jobTitle=Research+Fellow%3A++3DTreePrint+Project" target="_blank" rel="noopener">Read the advert &amp; apply <Icon name="arrow-up-right" /></a>
        <a class="arrow-link" href="mailto:m.mokros@ucl.ac.uk?subject=3DTreePrint%20postdoc">Questions? Email me <Icon name="arrow-right" /></a>
      </div>
    </article>

    <div class="routes reveal">
      <div class="card">
        <h2 class="card__title">PhD students</h2>
        <p class="card__body">I supervise in 3D remote sensing of forests and urban trees — point clouds, low-cost sensing, AI for tree analysis, open reproducible workflows. Email me a short note on what you want to work on and your CV before you apply, so we can shape a project that fits both of us.</p>
      </div>
      <div class="card">
        <h2 class="card__title">Postdocs</h2>
        <p class="card__body">When funded positions open, they're advertised on the UCL jobs site. Outside that, I actively help strong candidates win their own fellowships. So, get in touch well before the deadline and we'll build the proposal together. Check some options below.</p>
        <div class="chip-links">
          {fellowships.map((f) => <a class="chip-link" href={f.href} target="_blank" rel="noopener">{f.label} <Icon name="arrow-up-right" /></a>)}
        </div>
      </div>
      <div class="card">
        <h2 class="card__title">Self-funded OR bring-your-own-funding</h2>
        <p class="card__body">Have a scholarship from your home country, a national fellowship, or your own funding? We are genuinely open to hosting you.</p>
      </div>
      <div class="card">
        <h2 class="card__title">Visiting researchers</h2>
        <p class="card__body">Short research visits are possible through UCL's visiting schemes. Get in touch before applying so we can plan something worthwhile.</p>
      </div>
    </div>

    <div class="join__callout reveal"><b>Include in your email:</b> tell me (1) what you want to work on, (2) why with me specifically, and (3) your funding situation. </div>
    <div class="join__cta reveal"><h2 class="t-h3">Think you're a fit?</h2><a class="button button--primary" href="mailto:m.mokros@ucl.ac.uk?subject=Joining%20the%20group">Email me <Icon name="arrow-right" /></a></div>
  </div></section>

<style>
  .join{padding-top:0}
  .join__call .card__title{font-size:var(--fs-h3);line-height:1.15}
  .join__call .card__body{font-size:var(--fs-base)}
  .join__call .card__body b{color:var(--text);font-weight:600}
  .closed .js-apply{display:none}
  .routes{display:grid;gap:var(--s-6) var(--s-5);margin-top:var(--s-8)}
  @media(min-width:640px){.routes{display:block;columns:2;column-gap:var(--s-5)}.routes>.card{break-inside:avoid;margin-bottom:var(--s-6)}}
  .routes .chip-links{margin-top:var(--s-2)}
  .join__callout{margin-top:var(--s-7);padding:var(--s-5);border-left:3px solid var(--accent);background:var(--surface);border-radius:0 var(--r-2) var(--r-2) 0;color:var(--text-muted)}
  .join__callout b{color:var(--text);font-weight:600}
  .join__cta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--s-4);margin-top:var(--s-5);padding:var(--s-5) 0;border-top:1px solid var(--line-strong)}
  @media(min-width:960px){
    .join__call{grid-column:2/13}
    .routes{grid-column:1/13}
    .join__callout{grid-column:1/8;align-self:center;margin-top:var(--s-6)}
    .join__cta{grid-column:9/13;margin-top:var(--s-6);border-top:0;padding:0;flex-direction:column;align-items:flex-start;align-self:center}
  }
</style>
<script is:inline>
  // Flip open calls to "closed" after their deadline, without a redeploy.
  document.querySelectorAll('[data-closes]').forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.closes)) {
      el.classList.add('closed');
      el.querySelectorAll('.js-status').forEach((s) => (s.textContent = 'Applications closed'));
    }
  });
</script>
</Base>
